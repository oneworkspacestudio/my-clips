Page PostDetails variant=upload-post
  Row variant=upload-header
    Button action=previewMedia variant=upload-icon aria-label="Back to preview"
      Icon name=ChevronLeft size=30
    If condition=$workspace
      Link href=$workspace variant=upload-workspace workspaceApps=true aria-label="Open Workspace apps"
        Icon name=PanelsTopLeft size=22
    Spacer
    Text $kindLabel
  Stack variant=post-scroll
    Row variant=post-description
      Input name=caption multiline=true placeholder="Add description…" aria-label="Caption" maxLength=2200
      Button action=coverOptions variant=post-cover aria-label="Edit cover"
        Section id=media-thumbnail item=$cover
        Text variant=cover-top "Preview"
        Text variant=cover-bottom "Edit cover"
    Row variant=post-chips
      Button action=hashtag variant=upload-pill "# Hashtags"
      Button action=mention variant=upload-pill "@ Mention"
    Divider
    Button action=locationOptions variant=post-option
      Icon name=MapPin size=26
      Text "Location"
      Spacer
      Text variant=option-value $locationLabel
      Icon name=ChevronRight
    Button action=linkOptions variant=post-option
      Icon name=SquarePlus size=26
      Text "Add link"
      Spacer
      Icon name=ChevronRight
    Button action=audienceOptions variant=post-option
      Icon name=Globe2 size=26
      Text $audienceLabel
      Spacer
      Icon name=ChevronRight
    Button action=privacyOptions variant=post-option
      Icon name=LockKeyhole size=26
      Stack
        Text "Privacy settings"
        Text variant=option-hint "Manage comments and remixing."
      Spacer
      Icon name=ChevronRight
    Button action=moreOptions variant=post-option
      Icon name=Settings2 size=26
      Text "More options"
      Spacer
      Text variant=option-value $scheduleLabel
      Icon name=ChevronRight
    Button action=shareOptions variant=post-option
      Icon name=Share2 size=26
      Text "Share to"
      Spacer
      Text variant=option-value "My Clips"
      Icon name=ChevronRight
    If condition=$renderStatus
      Alert $renderStatus
  Row variant=upload-footer
    Button action=saveDraft variant=upload-secondary
      Icon name=Archive
      Text "Drafts"
    Button action=publishClip variant=upload-primary disabled=$noClips
      Icon name=ArrowUpCircle
      Text $postLabel
